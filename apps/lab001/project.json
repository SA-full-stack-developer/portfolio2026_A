{
  "name": "lab001",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/lab001/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "entryPoints": [
          "apps\\lab001\\src\\main.ts"
        ],
        "projectName": "lab001"
      },
      "configurations": {
        "production": {
          "target": "lab001:esbuild:production"
        },
        "development": {
          "target": "lab001:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "lab001:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "cacheExternalArtifacts": false,
        "port": 0,
        "entryPoints": [
          "apps\\lab001\\src\\main.ts"
        ],
        "projectName": "lab001"
      },
      "continuous": true
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/lab001/jest.config.cts",
        "tsConfig": "apps/lab001/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "lab001:build",
        "staticFilePath": "dist/apps/lab001/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/lab001",
        "browser": "apps/lab001/src/main.ts",
        "tsConfig": "apps/lab001/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/lab001/public"
          }
        ],
        "styles": [
          "apps/lab001/src/styles.scss"
        ],
        "polyfills": [
          "es-module-shims"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/shared/styles/src/lib"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "lab001:esbuild:production"
        },
        "development": {
          "buildTarget": "lab001:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      }
    }
  }
}